# ---------------------------------------------------------------------------
# A++ — environment template. Copy to .env and fill in.
#   cp .env.example .env
# Everything is optional: with no keys at all the app runs fully on the local
# filesystem backend + MockProvider, so you can develop offline.
# ---------------------------------------------------------------------------

# --- Backblaze B2 (storage) ---------------------------------------------
# Bucket must be created with Object Lock ENABLED (cannot be toggled later).
# Leave B2_KEY_ID blank to fall back to the local filesystem backend.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=us-west-004

# Days of GOVERNANCE-mode Object Lock retention applied to manifests only.
# Set 0 to disable locking entirely.
MANIFEST_RETENTION_DAYS=7

# --- Image generation providers (fallback chain, in order) --------------
# 1) GMI Cloud — hackathon sponsor credits, Seedream.
GMI_API_KEY=
GMI_IMAGE_MODEL=seedream-3-0-t2i-250415

# 2) Cloudflare Workers AI — 10k neurons/day free forever.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Comma-separated: each model is its own fallback link. All free tier.
CF_IMAGE_MODELS=@cf/leonardo/lucid-origin,@cf/leonardo/phoenix-1.0,@cf/black-forest-labs/flux-1-schnell

# 3) Replicate — paid last resort (~$0.003/image).
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# --- Compliance judge (vision LLM) --------------------------------------
# Groq free tier. MUST be a vision-capable model — a text-only model cannot
# see the image and would silently make the whole rubric fake.
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional OpenAI fallback for both image gen and the vision judge.
OPENAI_API_KEY=

# --- App ----------------------------------------------------------------
APP_DB_PATH=data/aplusplus.db
PARQUET_DIR=data/parquet
STORAGE_PREFIX=aplusplus
MAX_COMPLIANCE_RETRIES=2

# Job queue: leave REDIS_URL blank to use in-process background tasks.
REDIS_URL=
