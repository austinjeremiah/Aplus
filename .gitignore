# --- secrets ---
.env
*.pem
*.key

# --- build blueprint (kept local, not published) ---
A++.md

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- app data ---
# Ignore the directory's contents rather than the directory itself — git
# cannot un-ignore a file inside an ignored directory, and the run database
# needs to ship: a deployed instance with an empty one shows judges blank
# galleries and blank analytics.
data/*
*.db
# Exception, last so it wins: ship the seeded run history.
!data/aplusplus.db
*.sqlite3
tmp/
uploads/
out/

# --- node / frontend ---
node_modules/
.next/
dist/
build/
.turbo/

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- next build output ---
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env.local

# typescript incremental build cache
*.tsbuildinfo

